      "kind": "button",
      "refersTo": "button-primary",
      "description": "The filled primary action; export uses stronger weight than neutral controls.",
      "html": "<button class=\"ds-export\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 16V3m-5 5 5-5 5 5M4 15v6h16v-6\"/></svg>Export</button>",
      "css": ".ds-export{font-family:Inter,'Segoe UI',sans-serif;font-size:12px;font-weight:550;min-height:32px;padding:7px 10px;border:1px solid #343a45;border-radius:5px;display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:background-color .16s,border-color .16s;padding:7px 14px;background:var(--amber,#efb54d);border-color:var(--amber,#efb54d);color:#1a1409;font-weight:650}.ds-export:hover{background:#ffca6d;border-color:var(--amber,#efb54d)}.ds-export:active{background:var(--amber,#efb54d)}.ds-export:focus-visible{outline:2px solid var(--amber,#efb54d);outline-offset:2px;}.ds-export:disabled{opacity:.35} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none!important}}"
    },
