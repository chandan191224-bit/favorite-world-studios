      "css": ".ds-tabs{display:flex;gap:2px;padding:8px 9px 0;border-bottom:1px solid var(--line,#30343d);background:var(--panel,#191c22)}.ds-tab{flex:1;border:0;border-radius:0;min-height:37px;padding:8px 4px;background:transparent;color:#b5bfcd;font:550 11px Inter,\"Segoe UI\",sans-serif;transition:background-color .16s,border-color .16s}.ds-current{color:#efc075;border-bottom:2px solid var(--amber,#efb54d)}.ds-tab:hover{background:#2a303a}.ds-tab:active{background:#323a46}.ds-tab:focus-visible{outline:2px solid var(--amber,#efb54d);outline-offset:2px;} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none!important}}"
    },
    {
