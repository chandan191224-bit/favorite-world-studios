  "narrative": {
    "northStar": "The Documentary Editing Desk",
    "overview": "The established dark-panel and amber-control family is a quiet editing desk for documentary work. The media and chronology lead; the editor supplies legible controls, precise timing and a substantial preview. This is a code-led refinement of the pinned Clausd studio family after the user's rejection of the previous craft. It records the implementation, not a newly approved brand identity, seed or interface comp.\n\nOffline use on a Windows laptop and a phone constrains the system: bundled fonts and inline icons must work without a runtime CDN, controls must preserve portable projects and imported media, and expanded preview must make the output inspectable beyond a small embedded stage. Output palettes belong to individual documentary families; they do not recolor the editor.",
    "keyCharacteristics": [
      "Charcoal surfaces, restrained rules and purposeful amber state cues.",
      "Large media with distinct date, heading and caption hierarchy.",
      "Directly readable camera holds, travel spans and linked event selection.",
      "Grouped contextual editing, with timing promoted on phones."
    ],
    "rules": [
      {
        "name": "Amber Has a Job",
        "body": "Use filled amber for Export and the play transport, and amber accents for selection, focus and the playhead. Keep inactive editor controls neutral.",
        "section": "colors"
      },
      {
        "name": "Dates Are Not Timing",
        "body": "Keep calendar labels distinct from video arrival and hold values; use tabular numerals for editable timing and playback readouts.",
        "section": "typography"
      },
      {
        "name": "Flat Editing Desk",
        "body": "Use tonal layers and one-pixel rules for the editor. Reserve substantial shadows for the composition stage, transient feedback and dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the pinned dark/amber editor family and use bundled fonts and inline SVG icons.",
      "Do retain complete preset previews, readable multiword titles and distinct date/title/caption baselines.",
      "Do show arrival, hold, travel and event-media spans as meaningful timing relationships.",
      "Do keep the phone selection summary and timing fields ahead of content and collapsed media management.",
      "Do preserve editable content, source credits, portable projects and the exact renderer shared by preview and export."
    ],
    "donts": [
      "Don't introduce a PRO badge, emoji controls, a chip wall or decorative editor glow.",
      "Don't flatten the documentary families into color swaps or fit every offscreen event into the default shot.",
      "Don't treat generated illustrative cutout artwork as historical photography or an approved UI comp.",
      "Don't describe static browser captures as physical-phone approval, continuous-motion approval or optical depth-of-field validation."
    ]
  }
