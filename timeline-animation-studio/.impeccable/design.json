      "html": "<button class=\"ds-event\"><span class=\"ds-date\">1969</span><span><strong>Apollo 11</strong><small>Arrive 0.0s · hold 3.2s</small></span><span class=\"ds-order\">1</span></button>",
      "css": ".ds-event{display:flex;gap:11px;align-items:center;text-align:left;min-height:58px;padding:12px 10px;border:1px solid #b38c48;border-radius:5px;background:#2b281f;color:var(--text,#edf0f4);font-family:Inter,\"Segoe UI\",sans-serif;transition:background-color .16s,border-color .16s}.ds-date{min-width:46px;max-width:75px;font-size:15px;font-weight:600;font-variant-numeric:tabular-nums;color:#e4bd7a}.ds-event strong{display:block;font-size:12px;line-height:1.4}.ds-event small{display:block;font-size:10px;margin-top:4px;color:#aebbd0}.ds-order{margin-left:auto;color:#96a5bb;font-size:10px}.ds-event:hover{border-color:#b38c48}.ds-event:active{background:#2b281f}.ds-event:focus-visible{outline:2px solid var(--amber,#efb54d);outline-offset:2px;} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none!important}}"
