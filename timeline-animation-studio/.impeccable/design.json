      "html": "<label class=\"ds-field\"><span>Hold for (s)</span><input type=\"number\" value=\"3.2\" min=\"0.1\" max=\"60\" step=\"0.1\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;font:11px Inter,\"Segoe UI\",sans-serif;color:#c3cddb}.ds-field input{font:12px Inter,\"Segoe UI\",sans-serif;color:var(--text,#edf0f4);background:var(--input,#111419);padding:9px 10px;min-height:35px;border:1px solid #3a424f;border-radius:6px;caret-color:var(--amber,#efb54d);transition:background-color .16s,border-color .16s}.ds-field input:focus-visible{outline:2px solid var(--amber,#efb54d);outline-offset:2px;}@media(max-width:900px){.ds-field{font-size:12px}.ds-field input{font-size:13px;min-height:39px}} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none!important}}"
    },
