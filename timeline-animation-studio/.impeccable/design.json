      "css": ".ds-undo{font-family:Inter,'Segoe UI',sans-serif;font-size:12px;font-weight:550;min-height:32px;padding:7px 10px;border:1px solid #343a45;border-radius:5px;display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:background-color .16s,border-color .16s;width:32px;height:32px;padding:0;background:transparent;color:var(--text,#edf0f4)}.ds-undo:hover{background:transparent;border-color:#616b7c}.ds-undo:active{background:transparent}.ds-undo:focus-visible{outline:2px solid var(--amber,#efb54d);outline-offset:2px;} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none!important}}"
